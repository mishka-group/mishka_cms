<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Mishka CMS">
      {assigns[:page_title]}
    </.live_title>
    {raw(MishkaInstaller.Event.Hook.call("RootHtml.MetaTags", %{html: "", assigns: assigns}).html)}
    <% css_href =
      assigns[:current_site] &&
        "/assets/css/#{assigns[:current_site][:name]}/#{MishkaCmsCore.Runtime.States.AssetsState.get!(assigns[:current_site][:name], "css")[:hash]}.css" %>
    <% js_src =
      assigns[:current_site] &&
        "/assets/js/#{assigns[:current_site][:name]}/#{MishkaCmsCore.Runtime.States.AssetsState.get!(assigns[:current_site][:name], "js")[:hash]}.js" %>
    <link
      :if={css_href}
      rel="stylesheet"
      href={css_href}
      id="mishka-runtime-css"
    />
    <script :if={js_src} defer src={js_src}>
    </script>
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
