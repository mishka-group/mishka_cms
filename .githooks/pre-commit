# Fast checks on the staged Elixir files before every commit. The full gate is `MISHKA_DEPS=hex mix ci`.
# Turned on once per clone with `mix hooks`.
set -e
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.ex' '*.exs' '*.heex')
[ -z "$STAGED" ] && exit 0

mix format --check-formatted $STAGED
MIX_ENV=test mix credo --strict $STAGED
