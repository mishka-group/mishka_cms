# This file excludes paths from the Docker build context.
#
# By default, Docker's build context includes all files (and folders) in the
# current directory. Even if a file isn't copied into the container it is still sent to
# the Docker daemon.
#
# There are multiple reasons to exclude files from the build context:
#
# 1. Prevent nested folders from being copied into the container (ex: exclude
#    /assets/node_modules when copying /assets)
# 2. Reduce the size of the build context and improve build time (ex. /build, /deps, /doc)
# 3. Avoid sending files containing sensitive information
#
# More information on using .dockerignore is available here:
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

.dockerignore

# Ignore git, but keep git HEAD and refs to access current commit hash if needed:
#
# $ cat .git/HEAD | awk '{print ".git/"$2}' | xargs cat
# d0b8727759e1e0e7aa3d41707d12376e373d5ecc
.git
!.git/HEAD
!.git/refs

# Common development/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls

# Mix artifacts
/_build/
/deps/
*.ez

# Generated on crash by the VM
erl_crash.dump

# Static artifacts - These should be fetched and built inside the Docker image
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# A developer's checkouts of the CMS packages. The image takes them from Hex, at the versions
# mix.lock pins, the same as any other build of the project does.
/__extensions/

# Host runtime state and generated assets. priv/repo/migrations and priv/resource_snapshots STAY:
# the migrations are the copy's own (generated with `mix ash.codegen`, then committed), and the
# build's guard needs both the migrations and the snapshots they came from (see the Dockerfile).
/.mnesia/
/mishka_data/
/priv/static/temp/
/priv/static/uploads/
/priv/static/uploads_archived/

# The developer toolchain. The image's Elixir and OTP are the Dockerfile's own ARGs.
.tool-versions
