# Dockerfile.dev — a development container on the same Elixir, Erlang and Debian as the release
# builder (see the root Dockerfile), so dev and prod compile on one OTP.
FROM docker.io/hexpm/elixir:1.20.5-erlang-29.1.2-debian-trixie-20261027-slim

# bun, not npm: assets/ is a bun project (`mix assets.setup` runs `bun install`).
COPY --from=docker.io/oven/bun:1.4.4 /usr/local/bin/bun /usr/local/bin/bun

# A C toolchain for the NIFs, git for the git dependencies, inotify-tools for live reload and the
# Postgres client for `mix ecto.*` against the db service.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential git ca-certificates inotify-tools postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force \
    && mix local.rebar --force

ENV MIX_ENV=dev

# Keep the container running; work inside it with `docker compose exec app bash`.
CMD ["tail", "-f", "/dev/null"]
