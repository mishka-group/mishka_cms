#!/bin/sh

# Mnesia's schema under MISHKA_DATA_DIR belongs to the node that created it, and the default node
# name ends in the container's hostname, which changes on every redeploy. The node is therefore
# `mishka_cms@localhost`. To cluster, set RELEASE_DISTRIBUTION=name and a RELEASE_NODE per machine.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@localhost}"
